# Copy to backend/.env (git-ignored). Only the backend reads these; nothing here reaches the browser.

# --- Groq (LLM reasoning) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for the small background calls (memory extraction, preference learning): low|medium|high
GROQ_AUX_REASONING_EFFORT=low

# --- Hindsight (agent memory) ---
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# Prefix for per-user memory banks: each user gets "<prefix>-u-<user_id>"
HINDSIGHT_BANK_ID=incident-response-agent
# Recall is on the critical path; past this budget the analysis continues without history
HINDSIGHT_RECALL_TIMEOUT_SECONDS=15

# --- App ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_HOURS=168
# Include per-stage latency / token metrics in analysis responses (no incident content)
EXPOSE_METRICS=true

# --- Legacy migration only (pre-accounts databases). Leave DEMO_PASSWORD empty unless migrating. ---
DEMO_USERNAME=admin
DEMO_PASSWORD=
